            UNITY_LOCATION(x) layout(location = x)\n#define UNITY_BINDING(x) layout(binding
            = x, std140)\n#else\n#define UNITY_LOCATION(x)\n#define UNITY_BINDING(x)
            layout(std140)\n#endif\nuniform \tvec4 _Time;\nuniform \tvec4 _ZBufferParams;\nuniform
            \tvec4 _BaseColor;\nuniform \tfloat _TilingScale;\nuniform \tfloat _WaveTiling;\nuniform
            \tvec4 _WaveColor;\nuniform \tfloat _WaveSpeed;\nuniform \tfloat _WaveAngle;\nuniform
            \tfloat _WaveTilingSub;\nuniform \tvec4 _WaveColorSub;\nuniform \tfloat
            _WaveSpeedSub;\nuniform \tfloat _WaveAngleSub;\nuniform \tmediump vec4
            _EdgeColor;\nuniform \tfloat _DepthFactor;\nUNITY_LOCATION(0) uniform
            mediump sampler2D _MainTex;\nUNITY_LOCATION(1) uniform highp sampler2D
            _CameraDepthTexture;\nin highp  vec2 vs_TEXCOORD0;\nin highp  vec4 vs_TEXCOORD2;\nlayout(location
            = 0) out mediump vec4 SV_Target0;\nvec4 u_xlat0;\nmediump float u_xlat16_0;\nvec4
            u_xlat1;\nvec4 u_xlat2;\nvec2 u_xlat3;\nmediump float u_xlat16_3;\nfloat
            u_xlat6;\nfloat u_xlat9;\nvoid main()\n{\n    u_xlat0.x = _Time.x * _WaveSpeed;\n   
            u_xlat3.x = _WaveAngle * 0.0174532924;\n    u_xlat1.x = sin(u_xlat3.x);\n   
            u_xlat2.x = cos(u_xlat3.x);\n    u_xlat2.y = u_xlat1.x;\n    u_xlat0.xy
            = u_xlat0.xx * u_xlat2.xy;\n    u_xlat6 = _TilingScale * _WaveTiling;\n   
            u_xlat0.xy = vs_TEXCOORD0.xy * vec2(u_xlat6) + u_xlat0.xy;\n    u_xlat16_0
            = texture(_MainTex, u_xlat0.xy).w;\n    u_xlat3.x = _Time.x * _WaveSpeedSub;\n   
            u_xlat6 = _WaveAngleSub * 0.0174532924;\n    u_xlat1.x = sin(u_xlat6);\n   
            u_xlat2.x = cos(u_xlat6);\n    u_xlat2.y = u_xlat1.x;\n    u_xlat3.xy
            = u_xlat3.xx * u_xlat2.xy;\n    u_xlat9 = _TilingScale * _WaveTilingSub;\n   
            u_xlat3.xy = vs_TEXCOORD0.xy * vec2(u_xlat9) + u_xlat3.xy;\n    u_xlat16_3
            = texture(_MainTex, u_xlat3.xy).w;\n    u_xlat1 = (-_BaseColor) + _WaveColorSub;\n   
            u_xlat1 = u_xlat1 * _WaveColorSub.wwww;\n    u_xlat1 = vec4(u_xlat16_3)
            * u_xlat1 + _BaseColor;\n    u_xlat2 = (-_BaseColor) + _WaveColor;\n   
            u_xlat2 = _WaveColor.wwww * u_xlat2 + _BaseColor;\n    u_xlat2 = (-u_xlat1)
            + u_xlat2;\n    u_xlat0 = vec4(u_xlat16_0) * u_xlat2 + u_xlat1;\n   
            u_xlat1 = (-u_xlat0) + _EdgeColor;\n    u_xlat2.xy = vs_TEXCOORD2.xy
            / vs_TEXCOORD2.ww;\n    u_xlat2.x = texture(_CameraDepthTexture, u_xlat2.xy).x;\n   
            u_xlat2.x = _ZBufferParams.z * u_xlat2.x + _ZBufferParams.w;\n    u_xlat2.x
            = float(1.0) / u_xlat2.x;\n    u_xlat2.x = u_xlat2.x + (-vs_TEXCOORD2.w);\n   
            u_xlat2.x = u_xlat2.x * _DepthFactor;\n    u_xlat2.x = clamp(u_xlat2.x,
            0.0, 1.0);\n    u_xlat2.x = (-u_xlat2.x) + 1.0;\n    u_xlat2.x = u_xlat2.x
            * _EdgeColor.w;\n    u_xlat0 = u_xlat2.xxxx * u_xlat1 + u_xlat0;\n   
