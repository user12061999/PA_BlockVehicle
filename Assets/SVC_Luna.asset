            = u_xlat0.x * 3.14159274;\n    u_xlat0.x = max(u_xlat0.x, 0.0);\n   
            u_xlat16_2.xyz = texture(_MainTex, vs_TEXCOORD0.xy).xyz;\n    u_xlat16_11.xyz
