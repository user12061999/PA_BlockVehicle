            hlslcc_mtx4x4unity_WorldToObject[1].xyz);\n    u_xlat1.z = dot(in_NORMAL0.xyz,
            hlslcc_mtx4x4unity_WorldToObject[2].xyz);\n    u_xlat18 = dot(u_xlat1.xyz,
            u_xlat1.xyz);\n    u_xlat18 = max(u_xlat18, 1.17549435e-38);\n    u_xlat18
            = inversesqrt(u_xlat18);\n    u_xlat1.xyz = vec3(u_xlat18) * u_xlat1.xyz;\n   
            vs_TEXCOORD0.xy = in_TEXCOORD0.xy * _BaseMap_ST.xy + _BaseMap_ST.zw;\n   
            u_xlat18 = dot(u_xlat1.xyz, u_xlat1.xyz);\n    u_xlat18 = inversesqrt(u_xlat18);\n   
            u_xlat2.xyz = vec3(u_xlat18) * u_xlat1.xyz;\n    u_xlat16_3.x = min(_AdditionalLightsCount.x,
            unity_LightData.y);\n    u_xlatu18 =  uint(int(u_xlat16_3.x));\n    u_xlat16_3.x
            = float(0.0);\n    u_xlat16_3.y = float(0.0);\n    u_xlat16_3.z = float(0.0);\n   
            for(uint u_xlatu_loop_1 = uint(0u) ; u_xlatu_loop_1<u_xlatu18 ; u_xlatu_loop_1++)\n   
            {\n        u_xlatu20 = uint(u_xlatu_loop_1 >> (2u & uint(0x1F)));\n       
            u_xlati4 = int(uint(u_xlatu_loop_1 & 3u));\n        u_xlat20 = dot(unity_LightIndices[int(u_xlatu20)],
            ImmCB_1[u_xlati4]);\n        u_xlati20 = int(u_xlat20);\n        u_xlat4.xyz
            = (-u_xlat0.xyz) * _AdditionalLightsPosition[u_xlati20].www + _AdditionalLightsPosition[u_xlati20].xyz;\n       
            u_xlat22 = dot(u_xlat4.xyz, u_xlat4.xyz);\n        u_xlat22 = max(u_xlat22,
            6.10351562e-05);\n        u_xlat5.x = inversesqrt(u_xlat22);\n       
            u_xlat4.xyz = u_xlat4.xyz * u_xlat5.xxx;\n        u_xlat5.x = float(1.0)
            / float(u_xlat22);\n        u_xlat22 = u_xlat22 * _AdditionalLightsAttenuation[u_xlati20].x;\n       
            u_xlat16_21 = (-u_xlat22) * u_xlat22 + 1.0;\n        u_xlat16_21 = max(u_xlat16_21,
            0.0);\n        u_xlat16_21 = u_xlat16_21 * u_xlat16_21;\n        u_xlat22
            = u_xlat16_21 * u_xlat5.x;\n        u_xlat16_21 = dot(_AdditionalLightsSpotDir[u_xlati20].xyz,
            u_xlat4.xyz);\n        u_xlat16_21 = u_xlat16_21 * _AdditionalLightsAttenuation[u_xlati20].z
            + _AdditionalLightsAttenuation[u_xlati20].w;\n        u_xlat16_21 = clamp(u_xlat16_21,
            0.0, 1.0);\n        u_xlat16_21 = u_xlat16_21 * u_xlat16_21;\n       
            u_xlat22 = u_xlat16_21 * u_xlat22;\n        u_xlat5.xyz = vec3(u_xlat22)
            * _AdditionalLightsColor[u_xlati20].xyz;\n        u_xlat16_21 = dot(u_xlat1.xyz,
            u_xlat4.xyz);\n        u_xlat16_21 = clamp(u_xlat16_21, 0.0, 1.0);\n       
            u_xlat16_3.xyz = u_xlat5.xyz * vec3(u_xlat16_21) + u_xlat16_3.xyz;\n   
            }\n    vs_TEXCOORD5.yzw = u_xlat16_3.xyz;\n    vs_TEXCOORD1.xyz = u_xlat0.xyz;\n   
            vs_TEXCOORD5.x = 0.0;\n    vs_TEXCOORD2.xyz = u_xlat2.xyz;\n    vs_TEXCOORD7.xyz
            = vec3(0.0, 0.0, 0.0);\n    return;\n}\n\n"
          FragmentProgram: "\n#version 300 es\n\nprecision highp float;\nprecision
