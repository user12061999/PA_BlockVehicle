            mediump float                _Surface;\n\tUNITY_UNIFORM vec4 Xhlslcc_UnusedXunity_MipmapStreaming_DebugTex_ST;\n\tUNITY_UNIFORM
            vec4 Xhlslcc_UnusedXunity_MipmapStreaming_DebugTex_TexelSize;\n\tUNITY_UNIFORM
