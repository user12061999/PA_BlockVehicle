            * u_xlat0.xyz;\n    u_xlat16_0 = texture(_BaseMap, vs_TEXCOORD0.xy, _GlobalMipBias.x);\n   
            u_xlat16_0 = u_xlat16_0.wxyz * _BaseColor.wxyz;\n    u_xlat16_2.xyz =
