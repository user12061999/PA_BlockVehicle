            HLSLCC_ENABLE_UNIFORM_BUFFERS\n};\n#endif\nin highp vec4 in_POSITION0;\nin
            highp vec3 in_NORMAL0;\nvec4 u_xlat0;\nvec4 u_xlat1;\nmediump float u_xlat16_2;\nfloat
