            vec4                hlslcc_mtx4x4unity_WorldToObject[4];\n\tUNITY_UNIFORM
            vec4 Xhlslcc_UnusedXunity_LODFade;\n\tUNITY_UNIFORM mediump vec4 Xhlslcc_UnusedXunity_WorldTransformParams;\n\tUNITY_UNIFORM
