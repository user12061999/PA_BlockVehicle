            * u_xlat0.yyy + u_xlat0.xzw;\n    vs_TEXCOORD1.xyz = u_xlat0.xyz;\n   
            u_xlat0.x = dot(u_xlat1.xyz, u_xlat1.xyz);\n    u_xlat0.x = inversesqrt(u_xlat0.x);\n   
